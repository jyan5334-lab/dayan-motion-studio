{
 "schema": "dayan-motion/1",
 "templateId": "hook-opener",
 "version": "1.0.0",
 "status": "candidate",
 "engine": "dayan-html",
 "title": "钩子开场：结论巨字 + 证据数字",
 "use": "片头前 3–8 秒：先甩结论，再用一个数字或作品墙证明（对应参考片 A1 开场“打通了！→81”、风格 C“逐字稿工作流→X 万”）",
 "theme": "dark-tech",
 "author": "大琰DAYAN",
 "composition": {
  "id": "hook-opener",
  "width": 1920,
  "height": 1080,
  "fps": 60,
  "durationInFrames": 360,
  "layout": "landscape"
 },
 "inputSlots": [
  {
   "id": "title",
   "type": "text",
   "required": true,
   "maxLen": 10,
   "desc": "结论巨字，≤10 字，口播第一句的核心"
  },
  {
   "id": "highlight",
   "type": "text",
   "required": false,
   "default": "",
   "maxLen": 10,
   "desc": "标题里要染色的词"
  },
  {
   "id": "tag",
   "type": "text",
   "required": false,
   "default": "",
   "maxLen": 10,
   "desc": "斜贴的小标签（如 ONE PROMPT / 开诚布公）"
  },
  {
   "id": "number",
   "type": "number",
   "required": true,
   "desc": "证据数字"
  },
  {
   "id": "decimals",
   "type": "number",
   "required": false,
   "default": 0
  },
  {
   "id": "unit",
   "type": "text",
   "required": false,
   "default": "",
   "maxLen": 6
  },
  {
   "id": "label",
   "type": "text",
   "required": false,
   "default": "",
   "maxLen": 16,
   "desc": "数字上方小字"
  },
  {
   "id": "sub",
   "type": "text",
   "required": false,
   "default": "",
   "maxLen": 22,
   "desc": "数字下方一句话"
  }
 ],
 "layers": [
  {
   "id": "world",
   "role": "background",
   "z": 0
  },
  {
   "id": "presenter",
   "role": "presenter",
   "z": 1
  },
  {
   "id": "content",
   "role": "content",
   "z": 2
  },
  {
   "id": "type",
   "role": "typography",
   "z": 3
  },
  {
   "id": "subs",
   "role": "captions",
   "z": 8
  }
 ],
 "scenes": [
  {
   "id": "hook",
   "role": "claim",
   "startFrame": 0,
   "endFrame": 156,
   "entryState": "presenter-full",
   "exitState": "title-stamped",
   "maxHoldFrames": 120
  },
  {
   "id": "proof",
   "role": "evidence",
   "startFrame": 156,
   "endFrame": 360,
   "entryState": "title-stamped",
   "exitState": "number-settled",
   "maxHoldFrames": 360
  }
 ],
 "motionWindows": [
  {
   "id": "title-slam",
   "sceneId": "hook",
   "startFrame": 9,
   "endFrame": 45,
   "kind": "impact",
   "protected": true
  },
  {
   "id": "tag-stamp",
   "sceneId": "hook",
   "startFrame": 66,
   "endFrame": 99,
   "kind": "impact",
   "protected": true
  },
  {
   "id": "wall-push",
   "sceneId": "proof",
   "startFrame": 156,
   "endFrame": 192,
   "kind": "transition",
   "protected": true
  },
  {
   "id": "number-count",
   "sceneId": "proof",
   "startFrame": 174,
   "endFrame": 258,
   "kind": "count",
   "protected": true
  },
  {
   "id": "sub-rise",
   "sceneId": "proof",
   "startFrame": 252,
   "endFrame": 294,
   "kind": "text-reveal",
   "protected": true
  }
 ],
 "holds": [
  {
   "atFrame": 120,
   "maxFrames": 120,
   "minusFrames": 36
  },
  {
   "atFrame": 330,
   "maxFrames": 360,
   "minusFrames": 24
  }
 ],
 "cameraStates": [
  {
   "id": "hook-wide",
   "startFrame": 0,
   "endFrame": 156,
   "target": "title",
   "scale": 1.0
  },
  {
   "id": "proof-push",
   "startFrame": 156,
   "endFrame": 360,
   "target": "number",
   "scale": 1.0
  }
 ],
 "presenterStates": [
  {
   "atFrame": 0,
   "state": "full",
   "pos": "auto"
  },
  {
   "atFrame": 147,
   "state": "circle",
   "pos": "br"
  }
 ],
 "handoffs": [
  {
   "from": "hook.title",
   "to": "proof.number",
   "atFrame": 156
  },
  {
   "from": "hook.presenter",
   "to": "proof.presenter-circle",
   "atFrame": 147
  }
 ],
 "anchors": [
  {
   "id": "title",
   "atFrame": 9,
   "desc": "结论巨字砸下"
  },
  {
   "id": "proof",
   "atFrame": 156,
   "desc": "证据页转入"
  }
 ],
 "assets": [],
 "acceptance": [
  "safe-area",
  "cjk-font-render",
  "continuous-motion-windows",
  "handoff-continuity",
  "full-mp4-decode",
  "audio-and-caption-review"
 ]
}