{
 "schema": "dayan-motion/1",
 "templateId": "side-explainer",
 "version": "1.0.0",
 "status": "candidate",
 "engine": "dayan-html",
 "title": "侧推讲解：横拍整幅侧移+渐变遮罩 / 竖拍圆角人物卡+文字墙，叠卡要点 + 发光引用",
 "use": "人物正在全屏讲话，开始讲某个工具/方案的功能、优势、组成时：横拍素材整幅推到一侧、让出的一侧渐变压暗；竖拍素材裁成圆角人物卡放到一侧、身后露出品牌文字墙；叠卡逐张讲要点，最后一句结论发光（对应风格 D3 的侧推叠卡页 + 竖幅人物卡页）",
 "theme": "dark-tech",
 "author": "大琰DAYAN",
 "composition": {
  "id": "side-explainer",
  "width": 1920,
  "height": 1080,
  "fps": 60,
  "durationInFrames": 600,
  "layout": "any"
 },
 "inputSlots": [
  {
   "id": "beats",
   "type": "list",
   "required": false,
   "minItems": 0,
   "maxItems": 8,
   "default": [],
   "desc": "演示区的每一拍：[{c:组件名, props, cue|at, box?}]，按口播语义选组件（见 playbook「演示区语义对照」）"
  },
  {
   "id": "cards",
   "type": "list",
   "required": false,
   "minItems": 0,
   "maxItems": 4,
   "desc": "（简写）只讲功能/优势列点时用：[{title, sub, icon|logo, items:[{icon,t,d,cue}], cue}]；有 beats 时不用",
   "default": []
  },
  {
   "id": "quote",
   "type": "text",
   "required": false,
   "default": "",
   "maxLen": 22,
   "desc": "发光引用（这一段的结论，不是整句字幕）"
  },
  {
   "id": "quoteCue",
   "type": "text",
   "required": false,
   "default": "",
   "maxLen": 12,
   "desc": "引用在说到这个词时亮起（不填按自然时间）"
  },
  {
   "id": "style",
   "type": "text",
   "required": false,
   "default": "ornate",
   "maxLen": 8,
   "desc": "ornate 深蓝金边 / glass 玻璃 / clean 白卡"
  },
  {
   "id": "quoteFont",
   "type": "text",
   "required": false,
   "default": "light",
   "maxLen": 8,
   "desc": "light 细体发光 / tech 得意黑 / heavy 粗体"
  },
  {
   "id": "wallSkin",
   "type": "text",
   "required": false,
   "default": "gold",
   "maxLen": 12,
   "desc": "竖拍素材时身后文字墙的皮肤（gold / acid / platinum / song / lacquer …）"
  }
 ],
 "layers": [
  {
   "id": "presenter",
   "role": "presenter",
   "z": 1
  },
  {
   "id": "content",
   "role": "content",
   "z": 2
  },
  {
