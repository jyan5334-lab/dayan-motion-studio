  "fps": 60,
  "durationInFrames": 300,
  "layout": "landscape"
 },
 "inputSlots": [
  {
   "id": "ask",
   "type": "text",
   "required": false,
   "default": "觉得有用就点个关注吧",
   "maxLen": 18
  },
  {
   "id": "bye",
   "type": "text",
   "required": false,
   "default": "谢谢大家 · 下期再见",
   "maxLen": 14
  },
  {
   "id": "next",
   "type": "text",
   "required": false,
   "default": "",
   "maxLen": 18,
   "desc": "下期预告，空则不显示"
  }
 ],
