{
 "schema": "dayan-motion/1",
 "templateId": "cta-outro",
 "version": "1.0.0",
 "status": "candidate",
 "engine": "dayan-html",
 "title": "结尾：关注点赞收藏 + 道别 + 下期预告",
 "use": "片尾 5–10 秒（对应 A1 紫色放射 CTA → 黄色放射道别）。三个锚点可钉到口播关键词：ask / bye / next",
 "theme": "violet-dream",
 "author": "大琰DAYAN",
